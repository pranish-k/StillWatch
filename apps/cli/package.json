{
  "name": "stillwatch",
  "version": "0.1.0-alpha.1",
  "description": "A local flight recorder for coding agents: see what your agent did, what it touched, and what it left behind.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "stillwatch": "./dist/stillwatch.mjs"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/pranish-k/StillWatch#readme",
  "bugs": "https://github.com/pranish-k/StillWatch/issues",
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "claude-code",
    "agents",
    "security",
    "audit",
    "hooks",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranish-k/StillWatch.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@stillwatch/adapter-claude": "workspace:*",
    "@stillwatch/collector": "workspace:*",
    "@stillwatch/installer": "workspace:*",
    "@stillwatch/lab": "workspace:*",
    "@stillwatch/reports": "workspace:*",
    "@stillwatch/schema": "workspace:*",
    "@stillwatch/storage": "workspace:*"
  }
}
